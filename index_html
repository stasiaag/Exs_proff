<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Профориентолог — Экзамен 2026/2027</title>
<style>
:root{
  --c-bg:#fff7ed;
  --c-bg2:#fef3c7;
  --c-primary:#f97316;
  --c-primary-dark:#ea580c;
  --c-secondary:#8b5cf6;
  --c-accent:#06b6d4;
  --c-success:#10b981;
  --c-danger:#ef4444;
  --c-warning:#f59e0b;
  --c-text:#1f2937;
  --c-muted:#6b7280;
  --c-card:#ffffff;
  --c-border:#e5e7eb;
  --radius:14px;
  --shadow:0 6px 24px rgba(0,0,0,.08);
  --shadow-lg:0 12px 40px rgba(0,0,0,.12);
}
*{box-sizing:border-box;margin:0;padding:0}
html,body{height:100%}
body{
  font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Arial,sans-serif;
  background:linear-gradient(135deg,#fff7ed 0%,#fef3c7 50%,#ede9fe 100%);
  color:var(--c-text);
  line-height:1.55;
  min-height:100vh;
  padding:16px;
}
#app{max-width:880px;margin:0 auto}
h1,h2,h3{line-height:1.25}
h1{font-size:clamp(1.6rem,4vw,2.2rem);font-weight:800}
h2{font-size:clamp(1.3rem,3.5vw,1.7rem);font-weight:700}
h3{font-size:1.1rem;font-weight:700}

.card{
  background:var(--c-card);
  border-radius:var(--radius);
  box-shadow:var(--shadow);
  padding:20px;
  margin-bottom:16px;
}
.card-accent{
  background:linear-gradient(135deg,var(--c-primary) 0%,var(--c-secondary) 100%);
  color:#fff;
}
.card-accent h1,.card-accent h2,.card-accent h3{color:#fff}

button{
  font-family:inherit;
  font-size:1rem;
  font-weight:600;
  border:none;
  border-radius:10px;
  padding:12px 20px;
  cursor:pointer;
  min-height:44px;
  transition:transform .15s,box-shadow .15s,background .15s;
  touch-action:manipulation;
}
button:focus-visible{outline:3px solid var(--c-accent);outline-offset:2px}
button:active{transform:scale(.97)}
button:disabled{opacity:.5;cursor:not-allowed}
.btn-primary{
  background:linear-gradient(135deg,var(--c-primary) 0%,var(--c-primary-dark) 100%);
  color:#fff;
  box-shadow:0 4px 12px rgba(249,115,22,.3);
}
.btn-primary:hover:not(:disabled){box-shadow:0 6px 18px rgba(249,115,22,.4)}
.btn-secondary{
  background:var(--c-bg);
  color:var(--c-text);
  border:2px solid var(--c-border);
}
.btn-secondary:hover:not(:disabled){background:#fff}
.btn-success{
  background:linear-gradient(135deg,var(--c-success) 0%,#059669 100%);
  color:#fff;
}
.btn-block{width:100%;display:block}
.btn-group{display:flex;gap:10px;flex-wrap:wrap;margin-top:16px}

.progress-wrap{margin-bottom:20px}
.progress-bar{
  height:10px;
  background:var(--c-border);
  border-radius:10px;
  overflow:hidden;
  margin-top:8px;
}
.progress-fill{
  height:100%;
  background:linear-gradient(90deg,var(--c-primary),var(--c-secondary));
  border-radius:10px;
  transition:width .3s;
}
.progress-text{
  display:flex;
  justify-content:space-between;
  font-size:.9rem;
  color:var(--c-muted);
  font-weight:600;
}

.options{display:flex;flex-direction:column;gap:10px;margin-top:16px}
.option{
  display:flex;
  align-items:flex-start;
  gap:12px;
  padding:14px;
  background:var(--c-bg);
  border:2px solid transparent;
  border-radius:10px;
  cursor:pointer;
  transition:all .15s;
  text-align:left;
  width:100%;
  min-height:44px;
}
.option:hover:not(:disabled){background:#fef3c7;border-color:var(--c-warning)}
.option.selected{
  background:#fef3c7;
  border-color:var(--c-primary);
  box-shadow:0 0 0 3px rgba(249,115,22,.15);
}
.option.correct{
  background:#d1fae5;
  border-color:var(--c-success);
}
.option.incorrect{
  background:#fee2e2;
  border-color:var(--c-danger);
}
.option-marker{
  flex-shrink:0;
  width:28px;
  height:28px;
  border-radius:50%;
  background:#fff;
  border:2px solid var(--c-border);
  display:flex;
  align-items:center;
  justify-content:center;
  font-weight:700;
  font-size:.85rem;
  color:var(--c-muted);
}
.option.selected .option-marker{
  background:var(--c-primary);
  border-color:var(--c-primary);
  color:#fff;
}
.option.correct .option-marker{
  background:var(--c-success);
  border-color:var(--c-success);
  color:#fff;
}
.option.incorrect .option-marker{
  background:var(--c-danger);
  border-color:var(--c-danger);
  color:#fff;
}
.option-text{flex:1;padding-top:2px}

.feedback{
  margin-top:16px;
  padding:14px;
  border-radius:10px;
  border-left:4px solid;
  animation:fadeIn .3s;
}
.feedback.correct{
  background:#d1fae5;
  border-color:var(--c-success);
  color:#065f46;
}
.feedback.incorrect{
  background:#fee2e2;
  border-color:var(--c-danger);
  color:#991b1b;
}
.feedback-title{font-weight:700;margin-bottom:4px;display:flex;align-items:center;gap:6px}

.case-situation{
  background:linear-gradient(135deg,#ede9fe 0%,#fef3c7 100%);
  padding:16px;
  border-radius:10px;
  margin-bottom:16px;
  border-left:4px solid var(--c-secondary);
}
.case-question{
  background:var(--c-bg);
  padding:14px;
  border-radius:10px;
  margin-bottom:12px;
}
.case-question-title{font-weight:700;margin-bottom:10px;color:var(--c-secondary)}

.score-circle{
  width:160px;
  height:160px;
  border-radius:50%;
  margin:20px auto;
  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:center;
  background:conic-gradient(var(--c-primary) 0deg,var(--c-secondary) 360deg);
  color:#fff;
  box-shadow:var(--shadow-lg);
}
.score-inner{
  width:130px;
  height:130px;
  border-radius:50%;
  background:var(--c-card);
  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:center;
}
.score-value{font-size:2.2rem;font-weight:800;color:var(--c-primary)}
.score-label{font-size:.85rem;color:var(--c-muted)}

.grade{
  text-align:center;
  padding:16px;
  border-radius:10px;
  margin:16px 0;
  font-weight:700;
  font-size:1.1rem;
}
.grade.excellent{background:#d1fae5;color:#065f46}
.grade.good{background:#dbeafe;color:#1e40af}
.grade.satisfactory{background:#fef3c7;color:#92400e}
.grade.fail{background:#fee2e2;color:#991b1b}

.review-item{
  background:var(--c-card);
  border-radius:10px;
  padding:16px;
  margin-bottom:12px;
  border-left:4px solid var(--c-border);
}
.review-item.wrong{border-left-color:var(--c-danger)}
.review-item.right{border-left-color:var(--c-success)}
.review-question{font-weight:700;margin-bottom:8px}
.review-answer{font-size:.9rem;margin:4px 0}
.review-answer.user{color:var(--c-danger)}
.review-answer.correct-a{color:var(--c-success);font-weight:600}
.review-explanation{
  margin-top:8px;
  padding:10px;
  background:var(--c-bg);
  border-radius:8px;
  font-size:.9rem;
}

.nav-bar{
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap:10px;
  margin-top:20px;
  flex-wrap:wrap;
}

.start-hero{
  text-align:center;
  padding:30px 20px;
}
.start-icon{
  font-size:4rem;
  margin-bottom:16px;
  display:inline-block;
  animation:bounce 2s infinite;
}
.start-features{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(200px,1fr));
  gap:12px;
  margin:20px 0;
  text-align:left;
}
.feature{
  background:rgba(255,255,255,.9);
  padding:14px;
  border-radius:10px;
  display:flex;
  gap:10px;
  align-items:flex-start;
}
.feature-icon{font-size:1.5rem;flex-shrink:0}
.feature-text{font-size:.9rem}
.feature-title{font-weight:700;margin-bottom:2px}

.tabs{
  display:flex;
  gap:6px;
  margin-bottom:20px;
  background:var(--c-bg);
  padding:6px;
  border-radius:10px;
  overflow-x:auto;
}
.tab{
  flex:1;
  min-width:120px;
  padding:10px 14px;
  border-radius:8px;
  background:transparent;
  color:var(--c-muted);
  font-weight:600;
  font-size:.9rem;
  white-space:nowrap;
}
.tab.active{
  background:var(--c-card);
  color:var(--c-primary);
  box-shadow:0 2px 8px rgba(0,0,0,.06);
}

.badge{
  display:inline-block;
  padding:3px 10px;
  border-radius:20px;
  font-size:.75rem;
  font-weight:700;
  margin-left:6px;
}
.badge-primary{background:var(--c-primary);color:#fff}
.badge-success{background:var(--c-success);color:#fff}
.badge-danger{background:var(--c-danger);color:#fff}

@keyframes fadeIn{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:translateY(0)}}
@keyframes bounce{0%,100%{transform:translateY(0)}50%{transform:translateY(-10px)}}
.fade-in{animation:fadeIn .3s}

@media(max-width:480px){
  body{padding:10px}
  .card{padding:14px}
  .btn-group{flex-direction:column}
  .btn-group button{width:100%}
  .score-circle{width:140px;height:140px}
  .score-inner{width:115px;height:115px}
  .score-value{font-size:1.8rem}
}
.hidden{display:none!important}
</style>
</head>
<body>
<main id="app" role="main" aria-label="Экзамен профориентолога 2026/2027"></main>

<script>
/* =========================================================
   ВОПРОСЫ БЛОК 1 (актуально на приёмную кампанию 2026/2027)
