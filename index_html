const state = {
  screen:"start",
  currentQ:0,
  currentCase:0,
  currentCaseQ:0,
  answers:new Array(QUESTIONS.length).fill(null),
  caseAnswers:{},
  showFeedback:false,
  tab:"test"
};

function saveProgress(){
  try{
    localStorage.setItem("prof_exam_2026_progress",JSON.stringify({
      answers:state.answers,
      caseAnswers:state.caseAnswers,
      currentQ:state.currentQ,
      currentCase:state.currentCase,
      currentCaseQ:state.currentCaseQ,
      screen:state.screen,
      tab:state.tab
    }));
  }catch(e){}
}
function loadProgress(){
  try{
    const d=JSON.parse(localStorage.getItem("prof_exam_2026_progress"));
    if(!d) return false;
    state.answers=d.answers||state.answers;
    state.caseAnswers=d.caseAnswers||{};
    state.currentQ=d.currentQ||0;
    state.currentCase=d.currentCase||0;
    state.currentCaseQ=d.currentCaseQ||0;
    state.screen=d.screen||"start";
    state.tab=d.tab||"test";
    return true;
  }catch(e){return false}
}
function clearProgress(){
  try{localStorage.removeItem("prof_exam_2026_progress")}catch(e){}
}

/* =========================================================
   RENDER
   ========================================================= */
const app=document.getElementById("app");

function render(){
  app.innerHTML="";
  app.classList.add("fade-in");
  switch(state.screen){
    case "start":renderStart();break;
    case "test":renderTest();break;
    case "cases":renderCases();break;
    case "results":renderResults();break;
  }
  window.scrollTo({top:0,behavior:"smooth"});
}

