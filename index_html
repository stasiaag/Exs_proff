}

function renderTest(){
  const wrap=el("div");

  const tabs=el("div","tabs");
  const tabTest=el("button","tab"+(state.tab==="test"?" active":""));
  tabTest.textContent="📝 Тест ("+answeredCount()+"/"+QUESTIONS.length+")";
  tabTest.onclick=()=>{state.tab="test";render()};
  const tabCases=el("button","tab"+(state.tab==="cases"?" active":""));
  tabCases.textContent="💼 Кейсы ("+casesAnsweredCount()+"/"+CASES.length+")";
  tabCases.onclick=()=>{state.tab="cases";state.screen="cases";saveProgress();render()};
  tabs.appendChild(tabTest);tabs.appendChild(tabCases);
  wrap.appendChild(tabs);

  if(state.tab==="test"){
    renderTestContent(wrap);
  }
  app.appendChild(wrap);
}

function renderTestContent(wrap){
  const q=QUESTIONS[state.currentQ];
  const progress=el("div","card progress-wrap");
  const pct=((state.currentQ)/QUESTIONS.length*100).toFixed(1);
  progress.innerHTML=`
    <div class="progress-text">
      <span>Вопрос ${state.currentQ+1} из ${QUESTIONS.length}</span>
      <span>${pct}%</span>
    </div>
    <div class="progress-bar" role="progressbar" aria-valuenow="${pct}" aria-valuemin="0" aria-valuemax="100">
      <div class="progress-fill" style="width:${pct}%"></div>
    </div>
  `;
  wrap.appendChild(progress);

  const card=el("div","card");
  const qTitle=el("h2");
  qTitle.textContent=q.q;
  card.appendChild(qTitle);

  const opts=el("div","options");
  const letters=["А","Б","В","Г","Д","Е"];
  q.options.forEach((opt,i)=>{
    const btn=el("button","option");
    btn.setAttribute("role","radio");
    btn.setAttribute("aria-checked",state.answers[state.currentQ]===i?"true":"false");
    const marker=el("span","option-marker");
    marker.textContent=letters[i];
    const text=el("span","option-text");
    text.textContent=opt;
    btn.appendChild(marker);btn.appendChild(text);

    if(state.answers[state.currentQ]===i){
      btn.classList.add("selected");
      if(state.showFeedback){
        if(i===q.correct) btn.classList.add("correct");
        else btn.classList.add("incorrect");
      }
    }
    if(state.showFeedback && i===q.correct){
      btn.classList.add("correct");
    }

    btn.onclick=()=>{
      if(state.showFeedback) return;
      state.answers[state.currentQ]=i;
      state.showFeedback=true;
      saveProgress();
      render();
    };
    opts.appendChild(btn);
  });
  card.appendChild(opts);

  if(state.showFeedback && state.answers[state.currentQ]!==null){
    const fb=el("div","feedback");
    const isCorrect=state.answers[state.currentQ]===q.correct;
    fb.classList.add(isCorrect?"correct":"incorrect");
    fb.innerHTML=`
      <div class="feedback-title">${isCorrect?"✅ Верно!":"❌ Неверно"}</div>
      <div>${q.explanation}</div>
    `;
    card.appendChild(fb);
  }

  wrap.appendChild(card);

  const nav=el("div","nav-bar");
  const prev=el("button","btn-secondary");
  prev.textContent="← Назад";
  prev.disabled=state.currentQ===0;
  prev.onclick=()=>{state.showFeedback=false;state.currentQ--;saveProgress();render()};
  nav.appendChild(prev);

  const counter=el("span");
  counter.style.fontWeight="600";
  counter.style.color="var(--c-muted)";
  counter.textContent=(state.currentQ+1)+" / "+QUESTIONS.length;
  nav.appendChild(counter);

  if(state.currentQ<QUESTIONS.length-1){
    const next=el("button","btn-primary");
    next.textContent="Далее →";
    next.onclick=()=>{state.showFeedback=false;state.currentQ++;saveProgress();render()};
    nav.appendChild(next);
  }else{
    const finish=el("button","btn-success");
    finish.textContent="Перейти к кейсам →";
    finish.onclick=()=>{
      state.screen="cases";state.tab="cases";state.currentCase=0;state.currentCaseQ=0;
      saveProgress();render();
    };
    nav.appendChild(finish);
  }
  wrap.appendChild(nav);
}

function renderCases(){
  const wrap=el("div");

  const tabs=el("div","tabs");
  const tabTest=el("button","tab");
  tabTest.textContent="📝 Тест ("+answeredCount()+"/"+QUESTIONS.length+")";
  tabTest.onclick=()=>{state.tab="test";state.screen="test";saveProgress();render()};
  const tabCases=el("button","tab active");
  tabCases.textContent="💼 Кейсы ("+casesAnsweredCount()+"/"+CASES.length+")";
  tabCases.onclick=()=>{state.tab="cases";render()};
  tabs.appendChild(tabTest);tabs.appendChild(tabCases);
  wrap.appendChild(tabs);

  const c=CASES[state.currentCase];
  const progress=el("div","card progress-wrap");
  const pct=(state.currentCase/CASES.length*100).toFixed(1);
  progress.innerHTML=`
    <div class="progress-text">
      <span>Кейс ${state.currentCase+1} из ${CASES.length}</span>
      <span>${pct}%</span>
    </div>
    <div class="progress-bar"><div class="progress-fill" style="width:${pct}%"></div></div>
  `;
  wrap.appendChild(progress);

  const card=el("div","card");
  const title=el("h2");
  title.textContent=c.title;
  card.appendChild(title);

  const sit=el("div","case-situation");
  sit.innerHTML=`<strong>📖 Ситуация:</strong><br>${c.situation}`;
  card.appendChild(sit);

  c.questions.forEach((cq,qi)=>{
    const qWrap=el("div","case-question");
    const qTitle=el("div","case-question-title");
    qTitle.textContent=`Вопрос ${qi+1}: ${cq.q}`;
    if(cq.multi) qTitle.textContent+=" (можно выбрать несколько)";
    qWrap.appendChild(qTitle);

    const userAns=(state.caseAnswers[state.currentCase]||{})[qi]||[];
    const isAnswered=userAns.length>0;
    const showFb=isAnswered && !cq.multi;

    const opts=el("div","options");
    cq.options.forEach((opt,oi)=>{
      const btn=el("button","option");
      if(cq.multi){
        btn.setAttribute("role","checkbox");
        btn.setAttribute("aria-checked",userAns.includes(oi)?"true":"false");
      }else{
        btn.setAttribute("role","radio");
        btn.setAttribute("aria-checked",userAns[0]===oi?"true":"false");
      }
      const marker=el("span","option-marker");
      marker.textContent=String.fromCharCode(65+oi);
      const text=el("span","option-text");
      text.textContent=opt;
      btn.appendChild(marker);btn.appendChild(text);

      if(userAns.includes(oi)){
        btn.classList.add("selected");
        if(showFb){
          if(cq.correct.includes(oi)) btn.classList.add("correct");
          else btn.classList.add("incorrect");
        }
      }
      if(showFb && cq.correct.includes(oi)){
        btn.classList.add("correct");
      }

      btn.onclick=()=>{
        if(showFb) return;
        if(!state.caseAnswers[state.currentCase]) state.caseAnswers[state.currentCase]={};
        if(cq.multi){
          const arr=state.caseAnswers[state.currentCase][qi]||[];
          if(arr.includes(oi)) state.caseAnswers[state.currentCase][qi]=arr.filter(x=>x!==oi);
          else state.caseAnswers[state.currentCase][qi]=[...arr,oi];
          saveProgress();render();
        }else{
          state.caseAnswers[state.currentCase][qi]=[oi];
          saveProgress();render();
        }
      };
      opts.appendChild(btn);
    });
    qWrap.appendChild(opts);

    if(cq.multi && userAns.length>0 && !showFb){
      const confirm=el("button","btn-primary");
      confirm.style.marginTop="10px";
      confirm.textContent="✓ Подтвердить ответ ("+userAns.length+")";
      confirm.onclick=()=>{saveProgress();render()};
      qWrap.appendChild(confirm);
    }

    if(showFb){
      const isRight=arraysEqual(userAns.slice().sort(),cq.correct.slice().sort());
      const fb=el("div","feedback");
      fb.classList.add(isRight?"correct":"incorrect");
      fb.innerHTML=`
        <div class="feedback-title">${isRight?"✅ Верно!":"❌ Неверно"}</div>
        <div>${cq.explanation}</div>
      `;
      qWrap.appendChild(fb);
    }

    card.appendChild(qWrap);
  });

  wrap.appendChild(card);

  const nav=el("div","nav-bar");
  const prev=el("button","btn-secondary");
  prev.textContent="← Назад";
  prev.disabled=state.currentCase===0;
  prev.onclick=()=>{
    if(state.currentCase>0){state.currentCase--}
    saveProgress();render();
  };
  nav.appendChild(prev);

  const counter=el("span");
  counter.style.fontWeight="600";counter.style.color="var(--c-muted)";
  counter.textContent=(state.currentCase+1)+" / "+CASES.length;
  nav.appendChild(counter);

  const caseData=state.caseAnswers[state.currentCase]||{};
  const allAnswered=c.questions.every((cq,i)=>{
    const ua=caseData[i]||[];
    if(ua.length===0) return false;
    if(cq.multi){
      // Для мультивыбора — фидбек показывается только после подтверждения (т.е. когда showFb=true в рендере вопроса)
      // Простая проверка: есть ли хотя бы один ответ
      return true;
    }
    return true;
  });

  if(state.currentCase<CASES.length-1){
    const next=el("button","btn-primary");
    next.textContent="Следующий кейс →";
    next.disabled=!allAnswered;
    if(!allAnswered) next.title="Ответьте на все вопросы кейса";
    next.onclick=()=>{state.currentCase++;saveProgress();render()};
    nav.appendChild(next);
  }else{
    const finish=el("button","btn-success");
    finish.textContent="📊 Показать результат";
    finish.disabled=!allCasesAnswered();
    if(!allCasesAnswered()) finish.title="Ответьте на все кейсы";
    finish.onclick=()=>{state.screen="results";saveProgress();render()};
    nav.appendChild(finish);
  }
  wrap.appendChild(nav);
}

function renderResults(){
  const wrap=el("div");

  let correctQ=0;
  QUESTIONS.forEach((q,i)=>{if(state.answers[i]===q.correct) correctQ++});

  let correctCaseQ=0,totalCaseQ=0;
  CASES.forEach((c,ci)=>{
    c.questions.forEach((cq,qi)=>{
      totalCaseQ++;
      const userAns=(state.caseAnswers[ci]||{})[qi]||[];
      if(arraysEqual(userAns.slice().sort(),cq.correct.slice().sort())) correctCaseQ++;
    });
  });

  const totalQ=QUESTIONS.length+totalCaseQ;
  const totalCorrect=correctQ+correctCaseQ;
  const pct=Math.round(totalCorrect/totalQ*100);

  let grade,gradeClass,gradeText;
  if(pct>=90){grade="Отлично";gradeClass="excellent";gradeText="Вы демонстрируете высокий уровень профессиональной готовности к консультированию абитуриентов. 🎉"}
  else if(pct>=75){grade="Хорошо";gradeClass="good";gradeText="Хороший уровень знаний. Обратите внимание на разобранные ошибки. 👍"}
  else if(pct>=50){grade="Удовлетворительно";gradeClass="satisfactory";gradeText="Базовые знания есть, но требуется дополнительная подготовка по ряду тем. 📚"}
  else{grade="Требуется подготовка";gradeClass="fail";gradeText="Рекомендуется повторить материал и пройти экзамен повторно. 💪"}

  const hero=el("div","card card-accent");
  hero.style.textAlign="center";
  hero.innerHTML=`
    <h1>📊 Итоговый результат</h1>
    <div class="score-circle">
      <div class="score-inner">
        <div class="score-value">${pct}%</div>
        <div class="score-label">${totalCorrect} из ${totalQ}</div>
      </div>
    </div>
    <div class="grade ${gradeClass}">${grade}</div>
    <p>${gradeText}</p>
  `;
  wrap.appendChild(hero);

  const stats=el("div","card");
  stats.innerHTML=`
    <h2 style="margin-bottom:14px">📈 Детализация</h2>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:10px">
      <div style="background:#d1fae5;padding:12px;border-radius:10px;text-align:center">
        <div style="font-size:1.6rem;font-weight:800;color:#065f46">${correctQ}</div>
        <div style="font-size:.85rem;color:#065f46">Тест: верно</div>
      </div>
      <div style="background:#fee2e2;padding:12px;border-radius:10px;text-align:center">
        <div style="font-size:1.6rem;font-weight:800;color:#991b1b">${QUESTIONS.length-correctQ}</div>
        <div style="font-size:.85rem;color:#991b1b">Тест: ошибки</div>
      </div>
      <div style="background:#dbeafe;padding:12px;border-radius:10px;text-align:center">
        <div style="font-size:1.6rem;font-weight:800;color:#1e40af">${correctCaseQ}</div>
        <div style="font-size:.85rem;color:#1e40af">Кейсы: верно</div>
      </div>
      <div style="background:#fef3c7;padding:12px;border-radius:10px;text-align:center">
        <div style="font-size:1.6rem;font-weight:800;color:#92400e">${totalCaseQ-correctCaseQ}</div>
        <div style="font-size:.85rem;color:#92400e">Кейсы: ошибки</div>
      </div>
    </div>
  `;
  wrap.appendChild(stats);

  const wrongQ=[];
  QUESTIONS.forEach((q,i)=>{if(state.answers[i]!==q.correct) wrongQ.push({i,q})});
  if(wrongQ.length>0){
    const review=el("div","card");
    const title=el("h2");
    title.textContent="❌ Разбор ошибок — Тест";
    title.style.marginBottom="14px";
    review.appendChild(title);

    wrongQ.forEach(({i,q})=>{
      const item=el("div","review-item wrong");
      const qTitle=el("div","review-question");
      qTitle.textContent=`${i+1}. ${q.q}`;
      item.appendChild(qTitle);

      const userA=el("div","review-answer user");
      userA.textContent="Ваш ответ: "+(state.answers[i]!==null?q.options[state.answers[i]]:"— нет ответа —");
      item.appendChild(userA);

      const corrA=el("div","review-answer correct-a");
      corrA.textContent="Правильный ответ: "+q.options[q.correct];
      item.appendChild(corrA);

      const exp=el("div","review-explanation");
      exp.textContent="💡 "+q.explanation;
      item.appendChild(exp);

      review.appendChild(item);
    });
    wrap.appendChild(review);
  }

  const wrongCases=[];
  CASES.forEach((c,ci)=>{
    c.questions.forEach((cq,qi)=>{
      const userAns=(state.caseAnswers[ci]||{})[qi]||[];
      if(!arraysEqual(userAns.slice().sort(),cq.correct.slice().sort())){
        wrongCases.push({ci,qi,c,cq,userAns});
      }
    });
  });
  if(wrongCases.length>0){
    const review=el("div","card");
    const title=el("h2");
    title.textContent="❌ Разбор ошибок — Кейсы";
    title.style.marginBottom="14px";
    review.appendChild(title);

    wrongCases.forEach(({ci,qi,c,cq,userAns})=>{
      const item=el("div","review-item wrong");
      const qTitle=el("div","review-question");
      qTitle.textContent=`${c.title}, вопрос ${qi+1}: ${cq.q}`;
      item.appendChild(qTitle);

      const userA=el("div","review-answer user");
      const userTexts=userAns.length>0?userAns.map(i=>cq.options[i]).join("; "):"— нет ответа —";
      userA.textContent="Ваш ответ: "+userTexts;
      item.appendChild(userA);

      const corrA=el("div","review-answer correct-a");
      corrA.textContent="Правильный ответ: "+cq.correct.map(i=>cq.options[i]).join("; ");
      item.appendChild(corrA);

      const exp=el("div","review-explanation");
      exp.textContent="💡 "+cq.explanation;
      item.appendChild(exp);

      review.appendChild(item);
    });
    wrap.appendChild(review);
  }

  if(wrongQ.length===0 && wrongCases.length===0){
    const perfect=el("div","card");
    perfect.style.textAlign="center";
    perfect.innerHTML=`
      <div style="font-size:3rem;margin:10px 0">🏆</div>
      <h2>Безупречный результат!</h2>
      <p style="margin-top:10px">Вы ответили на все вопросы верно. Ваша профессиональная готовность на высшем уровне!</p>
    `;
    wrap.appendChild(perfect);
  }

  const actions=el("div","card");
  const restart=el("button","btn-primary btn-block");
  restart.textContent="🔄 Пройти заново";
  restart.onclick=()=>{
    if(confirm("Начать экзамен заново? Весь прогресс будет сброшен.")){
      clearProgress();
      state.screen="start";state.tab="test";
      state.currentQ=0;state.currentCase=0;state.currentCaseQ=0;
      state.answers=new Array(QUESTIONS.length).fill(null);
      state.caseAnswers={};state.showFeedback=false;
      render();
    }
  };
  actions.appendChild(restart);

  const home=el("button","btn-secondary btn-block");
  home.style.marginTop="10px";
  home.textContent="🏠 На главную";
  home.onclick=()=>{state.screen="start";render()};
  actions.appendChild(home);

  wrap.appendChild(actions);
  app.appendChild(wrap);
}

/* =========================================================
   HELPERS
   ========================================================= */
function el(tag,cls){
  const e=document.createElement(tag);
  if(cls) e.className=cls;
  return e;
}
function answeredCount(){
  return state.answers.filter(a=>a!==null).length;
}
function casesAnsweredCount(){
  let n=0;
  CASES.forEach((c,ci)=>{
    const cd=state.caseAnswers[ci]||{};
    if(c.questions.every((_,qi)=>(cd[qi]||[]).length>0)) n++;
  });
  return n;
}
function allCasesAnswered(){
  return CASES.every((c,ci)=>{
    const cd=state.caseAnswers[ci]||{};
    return c.questions.every((_,qi)=>(cd[qi]||[]).length>0);
  });
}
function arraysEqual(a,b){
  if(a.length!==b.length) return false;
  for(let i=0;i<a.length;i++) if(a[i]!==b[i]) return false;
  return true;
}

/* =========================================================
   INIT
   ========================================================= */
function init(){
  const has=loadProgress();
  if(!has){
    state.screen="start";
  }
  render();
}
init();
</script>
